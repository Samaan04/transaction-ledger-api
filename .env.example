PORT=3000
DB_HOST=localhost
# Host port for PostgreSQL: used by docker-compose.yml AND by the app/tests
DB_PORT=5433
DB_USER=ledger
DB_PASSWORD=ledger
DB_NAME=ledger
# Used by `npm run test:e2e`
TEST_DB_NAME=ledger_test
# Connection pool size (must exceed the parallelism you expect under load)
DB_POOL_SIZE=20
